<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BepuPhysics" Version="2.4.0" />
        <PackageReference Include="ImSharp" Version="1.93.0" />
        <PackageReference Include="OpenTK" Version="4.9.4" />
        <PackageReference Include="SharpGLTF.Core" Version="1.0.7" />
        <PackageReference Include="StbImageSharp" Version="2.30.16" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\Shaders\pbr.frag" />
        <EmbeddedResource Include="Resources\Shaders\pbr.vert" />
        <EmbeddedResource Include="Resources\Shaders\shadow.frag" />
        <EmbeddedResource Include="Resources\Shaders\shadow.vert" />
        <EmbeddedResource Include="Resources\Shaders\plane.frag" />
        <EmbeddedResource Include="Resources\Shaders\plane.vert" />
        <EmbeddedResource Include="Resources\Shaders\sky.frag" />
        <EmbeddedResource Include="Resources\Shaders\sky.vert" />
        <EmbeddedResource Include="Resources\Textures\grid.png" />
        <EmbeddedResource Include="Resources\Fonts\NotoSansMono.ttf" />
    </ItemGroup>

</Project>
